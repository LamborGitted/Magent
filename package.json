{
  "name": "@lantxx/magent",
  "version": "0.1.1",
  "description": "Isolated environment manager for AI agent harnesses",
  "license": "MIT",
  "author": "LamborGitted",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LamborGitted/Magent.git"
  },
  "bugs": {
    "url": "https://github.com/LamborGitted/Magent/issues"
  },
  "homepage": "https://github.com/LamborGitted/Magent#readme",
  "keywords": [
    "ai-agent",
    "agent-harness",
    "environment-manager",
    "pi",
    "codex",
    "claude-code",
    "gemini-cli"
  ],
  "type": "module",
  "bin": {
    "magent": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "commander": "^14.0.3",
    "smol-toml": "^1.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
